{
  "name": "learning-studio",
  "version": "0.3.1",
  "private": true,
  "description": "Learning Studio — an AH-AIOS learning platform for AI systems, governance, and WorldForge.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js studio-tests/*.test.js",
    "test:browser": "node studio-tests/browser-smoke.mjs",
    "test:worldforge": "node --test tests/governance.test.js",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-governance-acceptance.ps1"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^8.3.0"
  }
}
