{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://hydraporss.github.io/ah-aios-react-website/schemas/v1/manifest.schema.json",
  "title":"WorldForge Export Manifest","type":"object","additionalProperties":false,
  "required":["package_type","package_id","package_version","created_at","producer","schema_versions","record_counts","files","validation"],
  "properties":{
    "package_type":{"const":"ah-aios-worldforge"},
    "package_id":{"$ref":"./common.schema.json#/$defs/id"},
    "package_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "created_at":{"$ref":"./common.schema.json#/$defs/timestamp"},
    "producer":{"type":"object","required":["application","version"],"properties":{"application":{"const":"WorldForge"},"version":{"type":"string"},"commit":{"type":"string"}},"additionalProperties":false},
    "schema_versions":{"type":"object","additionalProperties":{"type":"string"}},
    "record_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
    "files":{"type":"array","items":{"type":"object","required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}},
    "external_references":{"type":"array","items":{"type":"object","required":["ref","reason"],"properties":{"ref":{"type":"string"},"reason":{"type":"string"}},"additionalProperties":false}},
    "validation":{"type":"object","required":["result","validator_version"],"properties":{"result":{"enum":["passed","failed","incomplete"]},"validator_version":{"type":"string"},"validation_run_id":{"$ref":"./common.schema.json#/$defs/id"}},"additionalProperties":false}
  }
}