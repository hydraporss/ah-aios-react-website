{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://hydraporss.github.io/ah-aios-react-website/schemas/v1/entity.schema.json",
  "title":"WorldForge Entity Record","type":"object",
  "allOf":[{"$ref":"./common.schema.json#/$defs/baseRecord"}],
  "required":["id","record_type","schema_version","world_id","name","entity_type","created_at","updated_at","created_by","updated_by","record_version","workflow_status","source_refs"],
  "properties":{
    "record_type":{"const":"entity"},"world_id":{"$ref":"./common.schema.json#/$defs/id"},
    "name":{"type":"string","minLength":1,"maxLength":240},
    "entity_type":{"enum":["person","civilization","place","object","organization","concept","species","technology","other"]},
    "description":{"type":"string","maxLength":30000},
    "identity_notes":{"type":"string","maxLength":20000},
    "canon_status":{"$ref":"./common.schema.json#/$defs/canonStatus"},
    "attributes":{"type":"object"}
  }
}