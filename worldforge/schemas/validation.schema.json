{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prompt Validation Schema",
  "description": "Schema for validating prompts in the AI Harness Command Builder",
  "type": "object",
  "required": ["template_id", "model", "instructions", "context", "variables"],
  "properties": {
    "template_id": {"type": "string", "description": "Template identifier", "minLength": 1},
    "model": {"type": "string", "description": "Model provider", "enum": ["gpt-4", "gpt-3.5", "claude-3", "gemini", "local"], "minLength": 1},
    "instructions": {"type": "string", "description": "Prompt instructions", "minLength": 1},
    "context": {
      "type": "object",
      "description": "Context variables",
      "properties": {
        "entity": {"type": "string", "description": "WorldForge entity reference"},
        "evidence": {"type": "string", "description": "Evidence reference"},
        "source": {"type": "string", "description": "Source data reference"},
        "memory": {"type": "string", "description": "Context memory reference"},
        "claim": {"type": "string", "description": "Claim identifier"}
      },
      "additionalProperties": true
    },
    "variables": {"type": "array", "description": "List of variable placeholders used", "items": {"type": "string", "pattern": "^\\{\\{[a-z_]+}}"}, "minItems": 0, "uniqueItems": true},
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "created": {"type": "string", "format": "date-time"},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}