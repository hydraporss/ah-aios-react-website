{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prompt Template Schema",
  "description": "Schema for prompt templates used in the AI Harness Command Builder",
  "type": "object",
  "required": ["id", "name", "description", "version", "created", "instructions", "variables"],
  "properties": {
    "id": {"type": "string", "description": "Unique identifier for the template", "pattern": "^[a-z]+$"},
    "name": {"type": "string", "description": "Display name of the template purpose", "minLength": 1},
    "description": {"type": "string", "description": "Brief description of the template purpose", "minLength": 1},
    "version": {"type": "string", "description": "Template version", "pattern": "^\\d+\\.\\d+$"},
    "created": {"type": "string", "format": "date", "description": "Date the template was created (ISO 8601)"},
    "instructions": {"type": "string", "description": "The main prompt instructions template", "minLength": 1},
    "variables": {"type": "array", "description": "List of variable placeholders used in the template", "items": {"type": "string", "pattern": "^\\{\\{[a-z_]+}}"}, "minItems": 0, "uniqueItems": true}
  },
  "additionalProperties": false
}