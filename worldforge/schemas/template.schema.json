{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Template Configuration Schema",
  "description": "Schema for template configuration files",
  "type": "object",
  "required": ["templates"],
  "properties": {
    "templates": {
      "type": "array",
      "description": "List of template configurations",
      "items": {"$ref": "#/$defs/template"},
      "minItems": 0
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "required": ["id", "name", "description", "version", "created", "instructions", "variables"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]+$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
        "created": {"type": "string", "format": "date"},
        "instructions": {"type": "string", "minLength": 1},
        "variables": {"type": "array", "items": {"type": "string"}, "minItems": 0, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  }
}