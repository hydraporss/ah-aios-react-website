# AH-AIOS Knowledge Kernel — environment template
# Copy to .env for local development. Never commit .env or real credentials.
# Do not prefix backend-only secrets with VITE_.

# Supabase project connection
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=

# Backend-only: never expose to browser bundles or client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# Backend-only model-provider credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LUMA_API_KEY=

# Embedding configuration (non-secret identifiers).
EMBEDDING_MODEL=
EMBEDDING_MODEL_VERSION=
